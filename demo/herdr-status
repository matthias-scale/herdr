#!/usr/bin/env python3
"""Report turn-end status to herdr. Agent-agnostic, no dependencies.

    herdr-status --agent codex --blocking 1 --agents 2
    echo '{"blocking":0,"agents":3}' | herdr-status --agent opencode

Exits 0 unconditionally: a turn-end hook must never wedge a turn.
"""

from __future__ import annotations

import argparse
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from herdr_status import report  # noqa: E402


def main() -> int:
    p = argparse.ArgumentParser(prog="herdr-status", description=__doc__)
    p.add_argument("--agent", default="claude", help="agent label, e.g. claude, codex")
    p.add_argument("--blocking", type=int, help="count of items only a human can clear")
    p.add_argument("--agents", type=int, help="count of agents still working")
    p.add_argument("--gate", action="append", default=[], help="repeatable gate text")
    p.add_argument("--agent-name", action="append", default=[], help="repeatable")
    p.add_argument("--session-id")
    p.add_argument("--session-path")
    p.add_argument("--json", action="store_true", help="print what was reported")
    args = p.parse_args()

    body: dict = {}
    if args.blocking is None or args.agents is None:
        if not sys.stdin.isatty():
            try:
                body = json.loads(sys.stdin.read() or "{}")
            except ValueError:
                body = {}

    blocking = args.blocking if args.blocking is not None else int(body.get("blocking", 0))
    agents = args.agents if args.agents is not None else int(body.get("agents", 0))

    outcome = report(
        agent=args.agent or body.get("agent") or "claude",
        blocking=max(0, blocking),
        agents=max(0, agents),
        gates=args.gate or body.get("gates") or [],
        agent_names=args.agent_name or body.get("agent_names") or [],
        session_id=args.session_id or body.get("session_id"),
        session_path=args.session_path or body.get("session_path"),
    )
    if args.json:
        print(json.dumps(outcome))
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except SystemExit:
        raise
    except Exception:  # noqa: BLE001 -- never wedge a turn
        raise SystemExit(0)
